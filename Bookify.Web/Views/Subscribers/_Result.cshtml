@model SubscriberSearchResultViewModel



<div class="card card-shadow-sm">
	<div class="card-body">
		@if (Model is null)
		{
			<div class="alert bg-light-warning border border-primary border-3 border-dashed d-flex flex-column justify-content-between align-items-center flex-sm-row w-100 p-5 mb-10">
				<!--begin::Content-->
				<div class="d-flex flex-column pe-0 pe-sm-10">
					<span>No subscribers where found!</span>
				</div>
				<a asp-action="Create" class="btn btn-primary btn-sm">Add Subscriber</a>
				<!--end::Content-->
			</div>
		}
		else
		{
			<div class="w-100 d-flex flex-column align-items-center">
				<div class="card shadow-sm w-50">
					<div class="card-header">
						<h3 class="card-title">@Model.FullName</h3>
						<div class="card-toolbar">
							<a class="btn btn-primary w-200px" asp-action="Details" asp-route-id="@Model.Key">Details</a>
						</div>
					</div>
					<div class="card-body p-0">
						<div class="card-p mb-10">
							<div class="text-center px-4">
								<div class="symbol symbol-200px">
								<img src="@Model.ImageUrl" alt="subscriber" />
							</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			



			@* <div class="w-100 d-flex flex-column align-items-center">

				<div class="symbol symbol-100px">
					<img src="@Model.ImageThumbnailUrl" alt="" />
				</div>
				<div class="d-flex flex-column justify-content-center">
					<h3>@Model.FirstName @Model.LastName</h3>
					<div>
						<a class="btn btn-primary w-200px" asp-action="Details" asp-route-id="Model.Id">Details</a>
					</div>
				</div>
				
			</div> *@
		}
	</div>
</div>




